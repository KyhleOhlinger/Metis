#!/bin/sh
# Auto-bump version when specs/CHANGELOG.md has a new top entry.
set -e
cd "$(git rev-parse --show-toplevel)"

npm run version:auto

git add \
  package.json \
  package-lock.json \
  src-tauri/Cargo.toml \
  src-tauri/tauri.conf.json \
  src-tauri/Cargo.lock \
  specs/.version-state.json \
  2>/dev/null || true
